{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        "coverage",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "**/*.test.ts",
        "**/*.test.js",
        "**/*.test.js.map",
        "**/*.test.d.ts"
      ],
      "predeploy": [
        "node \"$PROJECT_DIR/functions/scripts/nmt-admin.mjs\" deploy-check --project=line-auto-translate-bot-dev",
        "npm --prefix \"$RESOURCE_DIR\" run verify"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
