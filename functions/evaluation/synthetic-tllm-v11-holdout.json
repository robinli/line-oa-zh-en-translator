    "mentions": []
  },
  {
    "id": "v11h06",
    "sourceLanguage": "zh-TW",
    "targetLanguage": "en",
    "source": "EUR 68 佣金已包含在 EUR 947 裡，EUR 26 運費另加，不要重複加佣金。",
    "rubric": "費用包括與另加",
